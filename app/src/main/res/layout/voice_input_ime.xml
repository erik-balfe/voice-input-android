<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed panel height. UX: ↵ newline · orb listen/pause · ✓ done · top ⌨️ exit typing IME -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ime_panel_background"
    android:minHeight="188dp"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="14dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:paddingHorizontal="4dp">

        <ImageButton
            android:id="@+id/switch_keyboard"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/ime_top_icon_background"
            android:contentDescription="@string/ime_switch_keyboard"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_ime_keyboard"
            app:tint="@color/ime_top_icon" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:minWidth="64dp"
            android:maxWidth="200dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="0:00"
            android:textColor="@color/ime_status_text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/open_history"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ime_top_icon_background"
                android:contentDescription="@string/ime_open_history"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_ime_history"
                app:tint="@color/ime_top_icon" />

            <ImageButton
                android:id="@+id/open_app"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/ime_top_icon_background"
                android:contentDescription="@string/ime_open_settings"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_ime_settings"
                app:tint="@color/ime_top_icon" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:text="@string/ime_tip_speak"
        android:textColor="@color/ime_hint_text"
        android:textSize="12sp"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/debug_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:gravity="center"
        android:maxLines="2"
        android:paddingHorizontal="12dp"
        android:textColor="@color/ime_debug_text"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="108dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="2dp">

        <!-- New paragraph -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/newline"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@drawable/ime_stop_button_background"
                android:contentDescription="@string/ime_newline"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_ime_newline"
                app:tint="@color/ime_status_text" />
        </FrameLayout>

        <!-- Orb: listen / pause (primary) -->
        <FrameLayout
            android:id="@+id/orb_button"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/ime_stop_button_background"
            android:clickable="true"
            android:contentDescription="@string/ime_toggle_listen"
            android:focusable="true">

            <dev.erik.voiceinput.VoiceLevelCircleView
                android:id="@+id/voice_circle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="false"
                android:focusable="false" />
        </FrameLayout>

        <!-- Done → STT (or retry on failure) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/done"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@drawable/ime_stop_button_background"
                android:contentDescription="@string/ime_done"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_ime_done"
                app:tint="@color/ime_status_text" />

            <ImageButton
                android:id="@+id/retry"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@drawable/ime_stop_button_background"
                android:contentDescription="@string/ime_retry"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_ime_retry"
                android:visibility="gone"
                app:tint="@color/ime_status_text" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
