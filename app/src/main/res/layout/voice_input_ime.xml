<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed panel height: no GONE/VISIBLE height jumps (hint row always reserved). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ime_panel_background"
    android:minHeight="188dp"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="14dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:paddingHorizontal="8dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:minWidth="64dp"
            android:text="0:00"
            android:textColor="@color/ime_status_text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05" />

        <ImageButton
            android:id="@+id/open_app"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ime_open_settings"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_ime_settings"
            app:tint="@color/ime_status_text" />
    </FrameLayout>

    <!-- Always takes space (INVISIBLE when empty) so pause/tips never resize the panel. -->
    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:text="@string/ime_tip_speak"
        android:textColor="@color/ime_hint_text"
        android:textSize="12sp"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/debug_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:paddingHorizontal="12dp"
        android:textColor="@color/ime_debug_text"
        android:textSize="11sp"
        android:visibility="gone"
        android:maxLines="2" />

    <ProgressBar
        android:id="@+id/process_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="108dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="2dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/cancel"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@drawable/ime_stop_button_background"
                android:contentDescription="@string/ime_cancel"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_ime_cancel"
                app:tint="@color/ime_status_text" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/stop_button"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/ime_stop_button_background"
            android:clickable="true"
            android:contentDescription="@string/ime_mic_stop"
            android:focusable="true">

            <dev.erik.voiceinput.VoiceLevelCircleView
                android:id="@+id/voice_circle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="false"
                android:focusable="false" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/pause_resume"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@drawable/ime_stop_button_background"
                android:contentDescription="@string/ime_pause"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_ime_pause"
                app:tint="@color/ime_status_text" />

            <ImageButton
                android:id="@+id/retry"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@drawable/ime_stop_button_background"
                android:contentDescription="@string/ime_retry"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_ime_retry"
                android:visibility="gone"
                app:tint="@color/ime_status_text" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
